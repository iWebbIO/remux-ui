{"nodes": [{"id": "media_08_api_docs_dark_swagger_ui", "label": "Swagger API Documentation UI", "file_type": "image", "source_file": "media/08-api-docs-dark.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "media_08_api_docs_dark_dual_auth_mechanism", "label": "Dual Authentication Mechanism", "file_type": "rationale", "source_file": "media/08-api-docs-dark.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Supports both session cookies (for the SPA UI) and Bearer tokens (for programmatic clients) to accommodate both browser and script-based API consumers."}, {"id": "media_08_api_docs_dark_csrf_bypass_pattern", "label": "CSRF Bypass Pattern", "file_type": "rationale", "source_file": "media/08-api-docs-dark.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bearer-token API callers bypass CSRF requirements because token auth inherently protects against CSRF, while cookie-based SPA sessions must supply an X-CSRF-Token header on unsafe requests."}, {"id": "media_08_api_docs_dark_nested_json_pattern", "label": "Nested JSON Objects Pattern", "file_type": "rationale", "source_file": "media/08-api-docs-dark.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns complex structures like settings and streamSettings as nested JSON objects instead of escaped strings to improve developer experience, though legacy string-encoded writes are still accepted for backward compatibility."}, {"id": "media_08_api_docs_dark_slim_payload_optimization", "label": "Slim Payload Optimization", "file_type": "rationale", "source_file": "media/08-api-docs-dark.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provides a reduced /list/slim endpoint that strips down clients to {email, enable, comment} and omits UUIDs from ClientStats to save bandwidth and improve performance on UI list pages."}], "edges": [{"source": "media_08_api_docs_dark_swagger_ui", "target": "media_08_api_docs_dark_dual_auth_mechanism", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "media/08-api-docs-dark.png", "source_location": null, "weight": 1.0}, {"source": "media_08_api_docs_dark_swagger_ui", "target": "media_08_api_docs_dark_csrf_bypass_pattern", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "media/08-api-docs-dark.png", "source_location": null, "weight": 1.0}, {"source": "media_08_api_docs_dark_swagger_ui", "target": "media_08_api_docs_dark_nested_json_pattern", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "media/08-api-docs-dark.png", "source_location": null, "weight": 1.0}, {"source": "media_08_api_docs_dark_swagger_ui", "target": "media_08_api_docs_dark_slim_payload_optimization", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "media/08-api-docs-dark.png", "source_location": null, "weight": 1.0}, {"source": "media_08_api_docs_dark_dual_auth_mechanism", "target": "media_08_api_docs_dark_csrf_bypass_pattern", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "media/08-api-docs-dark.png", "source_location": null, "weight": 1.0}], "hyperedges": []}